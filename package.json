{
  "name": "camp-management",
  "version": "1.0.0",
  "private": true,
  "description": "Camp management system with mobile app and web dashboard",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "type-check": "turbo type-check",
    "dev:mobile": "turbo dev --filter=@camp/mobile",
    "dev:web": "turbo dev --filter=@camp/web",
    "build:mobile": "turbo build --filter=@camp/mobile",
    "build:web": "turbo build --filter=@camp/web"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.25.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "convex": "^1.34.1"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
